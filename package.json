  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260930.2",
    "typescript": "^5.8.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.145.0"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2"
  }
